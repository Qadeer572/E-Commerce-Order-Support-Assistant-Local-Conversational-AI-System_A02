# ShopBot Environment Configuration
# Copy this file to .env and adjust values as needed

# Ollama server URL (default: local)
OLLAMA_HOST=http://localhost:11434

# Model to use (must be pulled via 'ollama pull <model>')
SHOPBOT_MODEL=qwen2.5:0.5b
# Use qwen2.5:1.5b for more capacity with slower CPU inference.

# Generation parameters
SHOPBOT_TEMPERATURE=0.3
SHOPBOT_TOP_P=0.9
SHOPBOT_MAX_TOKENS=512
# Keep CPU weights resident between chats; startup loads them in the background.
SHOPBOT_KEEP_ALIVE=30m

# Context window budget (tokens reserved for conversation history)
SHOPBOT_MAX_HISTORY_TOKENS=1800
SHOPBOT_MIN_HISTORY_TURNS=2

# Session timeout in seconds (30 minutes)
SHOPBOT_SESSION_TIMEOUT=1800
# RAG relevance and total queue/retrieval deadline
SHOPBOT_RAG_THRESHOLD=0.40
SHOPBOT_RAG_TIMEOUT=1.5

# -- Assignment 3: voice (local Vosk ASR + Piper TTS; run scripts/prepare_voice_models.py once) --
SHOPBOT_VOICE_ENABLED=1
# SHOPBOT_ASR_MODEL_DIR=models/vosk-model-small-en-us-0.15
# SHOPBOT_TTS_VOICE=models/piper/en_US-lessac-medium.onnx
# Trailing silence that ends an utterance (fixed cost of any streaming ASR)
SHOPBOT_ASR_ENDPOINT_MS=600
SHOPBOT_ASR_MAX_JOBS=2
SHOPBOT_TTS_MAX_JOBS=2
# onnxruntime threads per synthesis so TTS does not starve Ollama
SHOPBOT_TTS_THREADS=2
SHOPBOT_AUDIO_CHUNK_SAMPLES=4000
SHOPBOT_VOICE_MAX_UTTERANCE_S=30

# -- Assignment 3: tools --
SHOPBOT_TOOLS_ENABLED=1
# Optional bigger model for the tool-decision call only (e.g. qwen2.5:1.5b)
# SHOPBOT_TOOL_MODEL=qwen2.5:1.5b
SHOPBOT_TOOL_DECISION_TIMEOUT=2.5
SHOPBOT_TOOL_TIMEOUT=2.0
# Failure injection for demos: <tool>:timeout or <tool>:error
# SHOPBOT_TOOL_FAULT=catalog_query:timeout
# SHOPBOT_SHOP_DB=data/shop.db
# SHOPBOT_CALENDAR_FILE=data/calendar.json
# SHOPBOT_CRM_DB=data/crm.db
